@startuml
skinparam DefaultFontColor #1f2937
skinparam ArrowColor #5b6b8c
skinparam ArrowFontColor #1f2937
skinparam ParticipantBackgroundColor #eef2fb
skinparam ParticipantBorderColor #5b6b8c
skinparam ActorBackgroundColor #eef2fb
skinparam ActorBorderColor #5b6b8c
skinparam DatabaseBackgroundColor #eef2fb
skinparam DatabaseBorderColor #5b6b8c
skinparam NoteBackgroundColor #dfe5fb
skinparam NoteBorderColor #5b6b8c
skinparam SequenceLifeLineBorderColor #5b6b8c
skinparam SequenceGroupBorderColor #5b6b8c
skinparam SequenceGroupBackgroundColor #dfe5fb
autonumber
title dex: one message, from the web UI to the model and back

actor "Browser" as user
participant "control (Go)\nHTTP + chat + live" as control
database "control.sqlite" as cdb
participant "worker (Bun)\nstdio NDJSON" as worker
database "agent state.sqlite" as adb
participant "Model provider" as model

user -> control : GET /api/chats/{id}/events (SSE)
control -> worker : watch (watchId)
worker --> control : event chat: snapshot
control --> user : snapshot (+ control's queued messages)
user -> control : POST /api/chats/{id}/messages {id: UUID, text}
control -> cdb : insert submission (pending, ID = UUID)
control --> user : 202
control --> user : item: user message, queued
opt first message of the chat
  control -> worker : createConversation
  worker -> adb : commit conversation
  control -> cdb : store worker conversation ID
end
control -> worker : submit (requestId = UUID)
worker -> adb : commit input as dex.user entry (durable)
worker --> control : submissionId
worker -> model : generate (tool calls run in agents/<id>/workspace)
model --> worker : text deltas, tool calls
worker --> control : event chat: item / append / run
control --> user : the same events
worker -> adb : commit answer
worker --> control : event settled
control -> cdb : submission done + answer

group worker exits before it settles
  control --> user : close the stream; the browser reconnects
  control -> control : restart worker (backoff 1 s to 30 s)
  control -> cdb : list pending submissions
  control -> worker : submit again, same requestId
  note right of worker
    pi-durable finds the same submission
    and resumes it from its last checkpoint
  end note
  worker --> control : event settled
end
@enduml
