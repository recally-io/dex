@startuml
skinparam DefaultFontColor #1f2937
skinparam ArrowColor #5b6b8c
skinparam ArrowFontColor #1f2937
skinparam ParticipantBackgroundColor #eef2fb
skinparam ParticipantBorderColor #5b6b8c
skinparam ActorBackgroundColor #eef2fb
skinparam ActorBorderColor #5b6b8c
skinparam DatabaseBackgroundColor #eef2fb
skinparam DatabaseBorderColor #5b6b8c
skinparam NoteBackgroundColor #dfe5fb
skinparam NoteBorderColor #5b6b8c
skinparam SequenceLifeLineBorderColor #5b6b8c
skinparam SequenceGroupBorderColor #5b6b8c
skinparam SequenceGroupBackgroundColor #dfe5fb
autonumber
title dex: native admission and business receipt projection

actor "Browser" as user
participant "Business services
HTTP + chat + live" as chat
database "control.sqlite" as cdb
participant "Native engine
PiG Harness + projection" as engine
database "agent state.sqlite" as adb
participant "Model provider" as model

user -> chat : POST message (client UUID)
chat -> cdb : Store input intent + origin
opt first input of the chat
  chat -> engine : Create(agent, options)
  engine -> adb : Commit execution conversation
  engine --> chat : Ref{AgentID, ID}
  chat -> cdb : Store execution_id
end
chat -> engine : Submit(ref, request ID, metadata)
engine -> adb : Commit admission + input or native Inbox
engine --> chat : Native Submission handle
chat -> cdb : Mark receipt admitted
chat --> user : 202 Accepted
user -> chat : Open SSE
chat -> engine : Watch(ctx, ref)
engine --> chat : Typed snapshot + independent Events channel
chat --> user : snapshot (includes native queued input)
engine -> model : Generate (tools use explicit agent environment)
model --> engine : Text and tool changes
engine --> chat : Typed item / append / run events
chat --> user : Encode events as SSE
engine -> adb : Commit answer + outcome
chat -> engine : Submission.Wait(ctx)
engine --> chat : Outcome
chat -> cdb : Settle receipt + wake channel outbox

group admission or receipt write interrupted
  chat -> engine : Submit same stable request ID
  engine -> adb : Reacquire admitted input or admit missing input
  engine --> chat : Same native submission
  chat -> cdb : Reconcile admission and outcome receipt
end
note over chat,engine
  One Go process. Separate store commits.
  A business receipt alone does not prove native admission.
end note
@enduml
