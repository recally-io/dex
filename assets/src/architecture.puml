skinparam BackgroundColor #ffffff
title dex: one process, separate data owners
top to bottom direction
rectangle "Browser
React UI" as browser
rectangle "Channels
Telegram / Feishu / WeChat" as channels
package "dex: one Go process" as runtime {
  rectangle "Business services
HTTP + chat + tasks + schedules
Input receipts + channel outbox" as business
  rectangle "Native engine
One PiG Harness per agent
Models + tools + MCP + memory" as engine
  rectangle "Live SSE
Typed watch events + heartbeat" as live
}
database "control.sqlite
Settings, chats, input receipts
Tasks and confirmed reply parts" as cdb
database "agents/<id>/state.sqlite
Native admission + Inbox
Runs, transcripts, tool calls" as adb
folder "Local agent files
agents/<id>/workspace
memory/ (shared Git repo)" as files
rectangle "Model providers" as models
browser --> business : HTTP commands
channels <--> business : Durable input + reply delivery
business --> cdb : Business facts
business --> engine : Typed methods + stable request IDs
engine --> adb : Execution authority
engine --> files : Explicit tool environment + memory commits
engine --> models : Model requests
browser --> live : Subscribe
live --> engine : Watch + History (typed)
live --> browser : Snapshot / item / append / run
note bottom of engine
  Durable metadata includes origin, attachments,
  and task labels. One transcript projection.
end note
@enduml
