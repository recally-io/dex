title dex plugins: optional sources outside the core path
top to bottom direction
rectangle "Sources\nGitHub / Webhook / Email" as sources
rectangle "Browser\nOwner API + UI" as browser
package "dex: one Go process" as runtime {
  rectangle "cmd/dex or native in-app host" as host
  rectangle "plugins/builtin\nPlugin factories" as builtin
  rectangle "internal/app\nBuild, check, keep enabled" as app
  rectangle "internal/server\n/hooks/<name>/ without token\n/api/plugins/<name>/ with token" as server
  package "plugins/<name>" as plugin {
    rectangle "Hooks + API\nVerify and parse" as handlers
    rectangle "Jobs + link tools" as extras
    rectangle "store + migrations\nplugin_<name>_ tables" as pstore
  }
  rectangle "internal/task\nEvent store, routing,\nholds, waits, links" as taskstore
  rectangle "Engine + scheduler" as core
}
database "control.sqlite\nenabled_plugins\napplied_plugin_migrations" as cdb
host --> builtin : Select factories
host --> app : Pass factories
app --> cdb : Read enabled_plugins,\nmigrate enabled plugins
app --> server : Mount enabled plugins
app --> core : Jobs + tools
sources --> server : Source events
browser --> server : Settings
server --> handlers : Route by name
handlers --> taskstore : Normalized events
extras --> taskstore : Links + waits
pstore --> cdb : Plugin tables
taskstore --> cdb : Task state
note bottom of taskstore
  The core never imports plugins/.
  A plugin that is off has no routes,
  jobs, or tools. Its data stays.
end note
@enduml
