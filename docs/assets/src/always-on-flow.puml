@startuml
skinparam RectangleBackgroundColor #eef2fb
skinparam RectangleBorderColor #5b6b8c
skinparam RectangleFontColor #1f2937
skinparam DatabaseBackgroundColor #eef2fb
skinparam DatabaseBorderColor #5b6b8c
skinparam DatabaseFontColor #1f2937
skinparam PackageBackgroundColor #eef2fb
skinparam PackageBorderColor #5b6b8c
skinparam DefaultFontColor #1f2937
skinparam ArrowColor #5b6b8c
skinparam ArrowFontColor #1f2937
skinparam NoteBackgroundColor #dfe5fb
skinparam NoteBorderColor #5b6b8c
skinparam NoteFontColor #1f2937
skinparam BackgroundColor #ffffff
title dex: always-on agent inbox, run exit modes, outbox, and monitors
top to bottom direction

rectangle "User inputs\nWeb / Telegram / Feishu / WeChat" as user_in
rectangle "Internal producers\nChild results + command Monitor wakes + Routines" as sys_in
database "monitors\nPrompt or script; bounded runs and lifetime" as monitors
rectangle "Scheduler\nCheck target and claim due work" as sched

database "Agent Inbox (submissions)\nDurable receipts + source dedup" as inbox

package "Native PiG session run (QueueAll boundary batching)" as run {
  rectangle "User Turn\nlive.Run.Inputs has user message\nLive stream + auto reply on settle" as user_turn
  rectangle "System Turn\nOnly task / Monitor / routine\nFail-quiet trace by default" as sys_turn
}

rectangle "Explicit exit tools\nnotify_user / ask_user\nchild session_send (report to parent)" as tools
database "Agent Outbox (outbox_messages)\nDeduplicated + topic superseding" as outbox
rectangle "Channel Dispatcher + Web UI\nAt-least-once parts + Attention Inbox" as dispatch

monitors --> sched : Due check
sched --> inbox : Stable follow-up ID\nPrompt due / check changed / terminal
user_in --> inbox : message
sys_in --> inbox : task_result / wake

inbox --> user_turn : Batch includes user message
inbox --> sys_turn : System events only

user_turn --> outbox : Auto reply or ask_user
sys_turn --> tools : Optional call
tools --> outbox : notify_user / ask_user
tools --> monitors : monitor_set_schedule (bounded)
sys_turn ..> outbox : System error fallback only

outbox --> dispatch : Deliver to peer + Web view
note right of sys_turn
  Command Monitors with wake="none" send no wake-up.
  Silent System Turns emit 0 channel messages.
end note
@enduml
