title Dex server: one process, separate data owners
top to bottom direction
rectangle "Browser
React UI" as browser
rectangle "Channels
Telegram / Feishu / Lark / WeChat" as channels
package "cmd/dex: one Go process" as runtime {
  rectangle "HTTP API + embedded UI" as http
  rectangle "Channel adapters + delivery" as delivery
  rectangle "Business services
Sessions, Tasks, Automations" as business
  rectangle "Native engine
One PiG Harness per bot
Models + tools + MCP + memory" as engine
  rectangle "Live SSE
Typed watch events + heartbeat" as live
}
database "control.sqlite
Settings, sessions, input receipts
Tasks and platform delivery receipts" as cdb
database "agents/<id>/state.sqlite
Native admission and native Inbox
Runs, transcripts, tool calls" as adb
folder "Local bot files
agents/<id>/workspace
agents/<id>/artifacts
memory/ (shared Git repo)" as files
rectangle "Model providers" as models
browser --> http : HTTP
http --> business : API calls
channels <--> delivery : Intake + replies
delivery --> business : Input intents
delivery --> cdb : Webhook Queue + Outbox
business --> cdb : Business facts
business --> engine : Typed methods + stable request IDs
engine --> adb : Execution authority
engine --> files : Explicit tool environment + memory commits
engine --> models : Model requests
http --> live : Open SSE
live --> engine : Watch + History (typed)
live --> browser : Snapshot / item / append / run
note bottom of engine
  Durable metadata includes origin, attachments,
  and input kind. One transcript projection.
end note
@enduml
