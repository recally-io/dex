#!/usr/bin/env bash
#MISE description="Build the development machine service archives that the dev server serves"
set -euo pipefail

data_dir="${DEX_DATA_DIR:-$HOME/.dex-dev}"
out="$data_dir/machine-release"
version=v0.0.0-dev

mkdir -p "$out"
stamp="$out/.stamp"
if [[ -f "$stamp" ]] && [[ -z "$(find cmd/dex-agent internal -newer "$stamp" -print -quit)" ]]; then
  exit 0
fi

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
for os in linux darwin; do
  for arch in arm64 amd64; do
    CGO_ENABLED=0 GOOS="$os" GOARCH="$arch" go build -trimpath -ldflags '-s -w' -o "$tmp/dex-agent" ./cmd/dex-agent
    cp cmd/dex-agent/packaging/dex-agent.service cmd/dex-agent/packaging/com.recally.dex-agent.plist "$tmp/"
    COPYFILE_DISABLE=1 tar --no-xattrs -czf "$out/dex-agent_${version}_${os}_${arch}.tar.gz" -C "$tmp" dex-agent dex-agent.service com.recally.dex-agent.plist
    rm -f "$tmp/dex-agent"
  done
done
(cd "$out" && sha256sum dex-agent_*.tar.gz >checksums.txt)
touch "$stamp"
echo "machine release payloads refreshed in $out"
