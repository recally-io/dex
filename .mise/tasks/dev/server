#!/usr/bin/env bash
#MISE description="Run dex for development on port 18787 with data in ~/.dex-dev"
#MISE depends=["build:web", "dev:machine-release"]
set -euo pipefail

# Later flags win: `mise run dev:server -- --data-dir <dir>` uses other data.
go run ./cmd/dex --port 18787 --machine-listen 0.0.0.0:18788 --data-dir "$HOME/.dex-dev" "$@"
