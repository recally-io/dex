#!/usr/bin/env bash
#MISE description="Generate the Go servers and the web client from api/openapi.yaml"
set -euo pipefail

go tool oapi-codegen -config api/oapi-codegen.yaml api/openapi.yaml
for config in plugins/*/api/oapi-codegen.yaml; do
  go tool oapi-codegen -config "$config" api/openapi.yaml
done
(cd apps/web && bunx --no-install openapi-ts)
