#!/usr/bin/env bash
#MISE description="Reject retired web UI imports and tokens"
set -euo pipefail
if git grep -nE '(^|/)atoms/|(^|/)primitives/|@central-icons-react|@base-ui/react' -- 'web/src/*.ts' 'web/src/*.tsx' 'web/src/*.css' ':!web/src/components/ui/'; then
  echo 'retired web UI import found' >&2
  exit 1
fi
if git grep -nE -- '--(ink|line|surface|canvas|page|inset|hover|field|stripe|dex-accent)(-|:|\b)|\b(text|bg|border|ring|outline|divide|decoration|fill|stroke|from|to|via|placeholder|caret|accent|shadow)-((ink|line|surface|canvas|page|inset|hover|field|stripe|dex-accent)(-|\b))|shadow-(hairline|btn|overlay|inset-field)' web/src; then
  echo 'legacy web token found' >&2
  exit 1
fi
