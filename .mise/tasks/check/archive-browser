#!/usr/bin/env bash
#MISE description="Test the bot archive card, archived list and restore in an isolated browser"
#MISE depends=["build:web"]
set -euo pipefail

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
go build -tags dex_e2e -o "$tmp/dex" ./cmd/dex
node web/tools/archive-browser.mjs "$tmp/dex" "$@"
