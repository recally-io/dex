#!/usr/bin/env bash
#MISE description="Fail when the generated API code differs from what api/openapi.yaml gives"
set -euo pipefail

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
# The output in the config wins over -o, so generate from a copy of the config.
check() {
  local config="$1" out="$2"
  sed "s|^output: .*|output: $tmp/server.gen.go|" "$config" >"$tmp/config.yaml"
  go tool oapi-codegen -config "$tmp/config.yaml" api/openapi.yaml
  diff "$out" "$tmp/server.gen.go"
}
check api/oapi-codegen.yaml internal/api/server.gen.go
for config in plugins/*/api/oapi-codegen.yaml; do
  check "$config" "$(dirname "$config")/server.gen.go"
done
(cd apps/web && bunx --no-install openapi-ts --output "$tmp/web")
diff -r apps/web/src/api/generated "$tmp/web"
