#!/usr/bin/env bash
#MISE description="Run one partition of an integration package and record test timings"
#MISE depends=["build:web"]
set -euo pipefail

package="${1:?Pass ./internal/app or ./internal/chat}"
index="${2:?Pass a zero-based shard index}"
count="${3:?Pass the shard count}"
case "$package" in
  ./internal/app|./internal/chat) ;;
  *) echo "Expected ./internal/app or ./internal/chat." >&2; exit 2 ;;
esac
name="${package##*/}"
if [[ ! "$index" =~ ^(0|[1-9][0-9]*)$ || ! "$count" =~ ^[1-9][0-9]*$ ]] || (( index >= count )); then
  echo "Expected 0 <= index < count." >&2
  exit 2
fi

# Discover every top-level test, example, and fuzz seed. New tests need no manual assignment.
listing="$(go test -race -list . "$package")"
tests="$(printf '%s\n' "$listing" | grep -E '^(Test|Example|Fuzz)[^[:space:]]*$' | LC_ALL=C sort)"
selected="$(printf '%s\n' "$tests" | awk -v shard="$index" -v count="$count" '(NR - 1) % count == shard')"
if [[ -z "$selected" ]]; then
  echo "Shard $index has no tests." >&2
  exit 1
fi

mkdir -p .local/ci
printf '%s\n' "$tests" > ".local/ci/$name-$index-all.txt"
printf '%s\n' "$selected" > ".local/ci/$name-$index-selected.txt"
pattern="$(printf '%s\n' "$selected" | paste -sd '|' -)"
printf '%s shard %s/%s: %s tests\n' "$name" "$index" "$count" "$(printf '%s\n' "$selected" | wc -l | tr -d ' ')"
go test -race -json -run "^($pattern)$" "$package" | tee ".local/ci/$name-$index.jsonl"
