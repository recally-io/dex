#!/usr/bin/env bash
#MISE description="Check web types, lint, format, and reducer tests"
#MISE dir="web"
set -euo pipefail
if git grep -nE '(^|/)atoms/|(^|/)primitives/|@central-icons-react|@base-ui/react' -- 'src/*.ts' 'src/*.tsx' 'src/*.css' ':!src/components/ui/'; then
  echo 'retired web UI import found' >&2
  exit 1
fi
if git grep -nE -- '--(ink|line|surface|canvas|page|inset|hover|field|stripe|dex-accent)(-|:|\b)|\b(text|bg|border(-[trblxy])?|ring|outline|divide|decoration|fill|stroke|from|to|via|placeholder|caret|accent|shadow)-((ink|line|surface|canvas|page|inset|hover|field|stripe|dex-accent)(-|\b))|shadow-(hairline|btn|overlay|inset-field)' src; then
  echo 'legacy web token found' >&2
  exit 1
fi
bunx --no-install tsc --noEmit
bunx --no-install vp lint
bunx --no-install vp fmt --check
bunx --no-install vp test run
