#!/usr/bin/env bash
#MISE description="Build main in an isolated source snapshot and capture Inbox baseline pages"
set -euo pipefail

inbox_baseline="$(mktemp -d)"
trap 'rm -rf "$inbox_baseline"' EXIT
inbox_evidence="${1:?pass an absolute output directory}"
inbox_ref="${2:-origin/main}"
git archive "$inbox_ref" | tar -x -C "$inbox_baseline"
MISE_TRUSTED_CONFIG_PATHS="$inbox_baseline" mise -C "$inbox_baseline" run install:web
MISE_TRUSTED_CONFIG_PATHS="$inbox_baseline" mise -C "$inbox_baseline" run build:web
(cd "$inbox_baseline" && go build -tags dex_e2e -o "$inbox_baseline/dex" ./cmd/dex)
node web/tools/foundation-browser.mjs "$inbox_baseline/dex" "$inbox_evidence"
git rev-parse "$inbox_ref" > "$inbox_evidence/baseline.txt"
