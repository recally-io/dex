#!/usr/bin/env bash
#MISE description="Prove the Inbox acceptance test fails with main's implementation"
#MISE depends=["build:web"]
set -euo pipefail

inbox_proof="$(mktemp -d)"
trap 'rm -rf "$inbox_proof"' EXIT
python3 - "$inbox_proof" "${1:-origin/main}" <<'PY'
import json
import pathlib
import subprocess
import sys

root = pathlib.Path.cwd()
out = pathlib.Path(sys.argv[1])
base = sys.argv[2]
changed = subprocess.check_output(['git', 'diff', '--name-only', base, '--', '*.go'], text=True).splitlines()
added = subprocess.check_output(['git', 'ls-files', '--others', '--exclude-standard', '--', '*.go'], text=True).splitlines()
replace = {}
for index, name in enumerate(changed + added):
    if name.endswith('_test.go'):
        continue
    original = subprocess.run(['git', 'show', f'{base}:{name}'], capture_output=True)
    if original.returncode:
        replace[str(root / name)] = ''
    else:
        target = out / f'{index}.go'
        target.write_bytes(original.stdout)
        replace[str(root / name)] = str(target)
(out / 'overlay.json').write_text(json.dumps({'Replace': replace}))
PY
if go test -overlay "$inbox_proof/overlay.json" ./internal/app -run '^TestUserInbox' -count=1 > "$inbox_proof/failure.log" 2>&1; then
  cat "$inbox_proof/failure.log"
  echo 'Inbox acceptance test passed without the implementation' >&2
  exit 1
fi
cat "$inbox_proof/failure.log"
rg 'GET /api/inbox: 404' "$inbox_proof/failure.log"
