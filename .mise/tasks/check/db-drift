#!/usr/bin/env bash
#MISE description="Fail when internal/db/sqlc differs from what sqlc generates from the migrations"
set -euo pipefail

sqlc vet
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
cp -R internal sqlc.yaml "$tmp/"
(cd "$tmp" && rm -rf internal/db/sqlc && sqlc generate)
diff -r internal/db/sqlc "$tmp/internal/db/sqlc"
