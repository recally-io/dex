#!/usr/bin/env bash
#MISE description="Test artifact preview and continuation in an isolated Chrome profile"
#MISE depends=["build:web"]
set -euo pipefail

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
go build -tags dex_e2e -o "$tmp/dex" ./cmd/dex
node web/tools/artifact-browser.mjs "$tmp/dex" "$@"
