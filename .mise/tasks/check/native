#!/usr/bin/env bash
#MISE description="Check Go dependency boundaries and build the server and native app without cgo"
#MISE depends=["build:web"]
set -euo pipefail

if git ls-files worker internal/worker internal/workerbin | rg .; then
  echo "The native runtime must not retain worker sources or embedded worker binaries." >&2
  exit 1
fi
core_deps=$(go list -deps -test ./internal/...)
if rg '^github\.com/recally-io/dex/apps(/|$)' <<<"$core_deps"; then
  echo "Packages under the root internal/ must not depend on apps/." >&2
  exit 1
fi
server_deps=$(go list -deps ./cmd/dex)
if rg '^github\.com/recally-io/dex/apps/native(/|$)' <<<"$server_deps"; then
  echo "cmd/dex must not depend on apps/native/." >&2
  exit 1
fi
agent_deps=$(go list -deps ./cmd/dex-agent)
if rg '^github\.com/recally-io/dex/(apps|internal/app)(/|$)' <<<"$agent_deps"; then
  echo "cmd/dex-agent must not depend on apps/ or internal/app." >&2
  exit 1
fi
if rg '^github\.com/recally-io/dex/internal/(settings|session|engine)(/|$)' <<<"$agent_deps"; then
  echo "cmd/dex-agent must not depend on internal/settings, internal/session, or internal/engine." >&2
  exit 1
fi
if rg 'github.com/(recally-io/dex/internal/worker|MichaelKinsy/PiG/(tui|coding/extension/host)|nsgo-dev/nsgo)' <<<"$server_deps"; then
  echo "The server must not link the worker, terminal extension host, or NSGo." >&2
  exit 1
fi
native_deps=$(CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go list -deps ./apps/native)
if rg '^github\.com/recally-io/dex/internal/(mcptest|runner/runnertest)(/|$)' <<<"$server_deps"$'\n'"$agent_deps"$'\n'"$native_deps"; then
  echo "Production entry points must not depend on internal/mcptest or internal/runner/runnertest." >&2
  exit 1
fi
CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build ./apps/native/...
mkdir -p .local/native-builds
for native_target in darwin/arm64 darwin/amd64 linux/arm64 linux/amd64; do
  native_os="${native_target%/*}"
  native_arch="${native_target#*/}"
  CGO_ENABLED=0 GOOS="$native_os" GOARCH="$native_arch" go build -trimpath \
    -ldflags='-s -w' -o ".local/native-builds/dex-$native_os-$native_arch" ./cmd/dex
  wc -c ".local/native-builds/dex-$native_os-$native_arch"
done
