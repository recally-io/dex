#!/usr/bin/env bash
#MISE description="Check release metadata and print the changelog section for the tag"
set -euo pipefail

tag=${1:?Expected a release tag}
version=$(<VERSION)
if [[ $tag != "v$version" || ! $tag =~ ^v[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$ ]]; then
  echo "Tag $tag must match VERSION ($version)." >&2
  exit 1
fi

section() {
  awk -v heading="[$tag]" '
    /^## / { active = ($2 == heading); next }
    /^\[[^]]+\]: / { active = 0 }
    active { print }
  '
}
notes=$(section < CHANGELOG.md)
if [[ ! $notes =~ [^[:space:]] ]]; then
  echo "No release notes for $tag in CHANGELOG.md." >&2
  exit 1
fi

if [[ $version != *-* ]]; then
  # A maintenance release can be older than the stable line on main.
  main_version=$(git show origin/main:VERSION)
  if [[ ! $main_version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ || $(printf '%s\n' "$version" "$main_version" | sort -V | tail -1) != "$main_version" ]]; then
    echo "Sync VERSION to main before publishing $tag (main has $main_version)." >&2
    exit 1
  fi
  main_notes=$(git show origin/main:CHANGELOG.md | section)
  if [[ $main_notes != "$notes" ]]; then
    echo "Sync the $tag changelog section to main before publishing." >&2
    exit 1
  fi
fi
printf '%s\n' "$notes"
