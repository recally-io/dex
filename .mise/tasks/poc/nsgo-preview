#!/usr/bin/env bash
#MISE description="Run the NSGo workspace with an isolated dex or an explicit local service"
#MISE depends=["build:web"]
set -euo pipefail

port=${NSGO_PREVIEW_PORT:-19487}
valid_port() { [[ $1 =~ ^[1-9][0-9]{0,4}$ ]] && (( $1 > 1024 && $1 < 65536 )); }
valid_port "$port" || { echo 'Invalid preview port.' >&2; exit 2; }
upstream=$((port - 1))
if (($#)); then
  if [[ $# != 2 || $1 != --connect-local ]] || ! valid_port "$2" || [[ $2 == "$port" ]]; then
    echo 'Usage: mise run poc:nsgo-preview [--connect-local PORT]' >&2
    exit 2
  fi
  upstream=$2
fi
export DEX_API_URL="http://127.0.0.1:$upstream"
work=$(mktemp -d)
pid=
preview_pid=
cleanup() {
  if [[ -n $preview_pid ]]; then
    kill "$preview_pid" 2>/dev/null || true
    wait "$preview_pid" 2>/dev/null || true
  fi
  if [[ -n $pid ]]; then
    kill "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
  fi
  rm -rf "$work"
}
trap cleanup EXIT
trap 'exit 130' INT TERM

(cd experiments/nsgo && go tool nsgo build -target web -output "$work/site")
site=("$work/site/"*-web)
start_demo() {
go build -tags dex_e2e -o "$work/dex" ./cmd/dex
mkdir "$work/home"
env -i HOME="$work/home" PATH="$PATH" "$work/dex" serve --host 127.0.0.1 --port "$upstream" --data-dir "$work/data" >"$work/dex.log" 2>&1 &
pid=$!
# Only configure the process we started. Another service could own this port.
for ((i=0; i<300; i++)); do
  if grep -q 'dex is running' "$work/dex.log"; then break; fi
  if ! kill -0 "$pid" 2>/dev/null; then break; fi
  sleep .1
done
if ! grep -q 'dex is running' "$work/dex.log"; then
  tail -20 "$work/dex.log" >&2
  exit 1
fi
bot="$DEX_API_URL/api/bots/default"
curl --noproxy '*' -fsS "$bot" | jq '. + {provider:"faux", modelId:"echo"}' | \
  curl --noproxy '*' -fsS -X PUT -H 'Content-Type: application/json' --data-binary @- "$bot" >/dev/null

curl --noproxy '*' -fsS -H 'Content-Type: application/json' --data-binary '{"title":"体验 Bot 工作区","assigneeBotId":"default","note":"在这里添加备注，或发送给负责 Bot，然后查看它的主对话。"}' "$DEX_API_URL/api/tasks" >/dev/null

# Seed the page comparison only in the temporary Dex with the echo model.
if [[ ${NSGO_PREVIEW_PAGES_FIXTURE:-0} == 1 ]]; then
  session=$(curl --noproxy '*' -fsS -X POST "$bot/sessions" | jq -er '.id')
  curl --noproxy '*' -fsS -H 'Content-Type: application/json' --data-binary '{"id":"63a7a062-45ef-4311-98b4-d1ef699a2587","text":"Review the release notes."}' "$bot/sessions/$session/messages" >/dev/null
  curl --noproxy '*' -fsS -H 'Content-Type: application/json' --data-binary '{"name":"Weekly workspace review","prompt":"Review the weekly notes.","schedule":{"kind":"weekly","time":"09:00","days":[1]},"timeZone":"UTC","session":"new","enabled":false}' "$bot/automations" >/dev/null
  mkdir -p "$work/data/agents/default/artifacts"
  printf '%s\n' 'The desktop and phone clients are ready for review.' >"$work/data/agents/default/artifacts/release-notes.txt"
fi
}
if (($# == 0)); then
  start_demo
else
  echo "Connected mode: actions in this UI apply to $DEX_API_URL. No demo data will be created."
fi

cd web
node node_modules/vite/bin/vite.js preview --host 127.0.0.1 --strictPort --port "$port" --outDir "${site[0]}" &
preview_pid=$!
wait "$preview_pid"
