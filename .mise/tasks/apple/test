#!/usr/bin/env bash
#MISE description="Run the Apple client tests with a macOS window and real WebKit"
#MISE depends=["build:web"]
set -euo pipefail
cd "${MISE_PROJECT_ROOT:?}/apps/native"
# Run the full client suite headless, then run the WebKit tests in a macOS host.
go tool nsgo test .
exec go tool nsgo test -target macos ./internal/webview
