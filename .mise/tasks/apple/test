#!/usr/bin/env bash
#MISE description="Run the Apple client tests with a macOS window and real WebKit"
#MISE depends=["build:web"]
set -euo pipefail
cd "${MISE_PROJECT_ROOT:?}/apps/native"
# Only the headless host can select an iPhone environment on a Mac.
mise exec go@1.27.3 -- go tool nsgo test -run '^TestUser(OnPhoneCannotSaveAnHTTPAddress|ChoosesAndForgetsLocalWorkspace)$' .
exec mise exec go@1.27.3 -- go tool nsgo test -target macos .
