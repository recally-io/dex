#!/usr/bin/env bash
#MISE description="Compile the Bun worker for GOOS/GOARCH (default: host) and gzip it for go:embed"
#MISE sources=["worker/src/**/*.ts", "worker/package.json", "worker/bun.lock"]
#MISE outputs=["internal/workerbin/dex-worker.gz"]
set -euo pipefail

goos="${GOOS:-$(go env GOOS)}"
goarch="${GOARCH:-$(go env GOARCH)}"
case "$goarch" in
amd64) arch=x64 ;;
arm64) arch=arm64 ;;
*) echo "unsupported GOARCH: $goarch" >&2 && exit 1 ;;
esac

out="$(mktemp -d)"
trap 'rm -rf "$out"' EXIT

# The worker runs with its cwd in the dex cache directory, next to agent-writable files.
# Do not let it load .env or bunfig.toml from there.
(cd worker && bun build src/main.ts --compile --minify \
	--target="bun-$goos-$arch" \
	--no-compile-autoload-dotenv --no-compile-autoload-bunfig \
	--outfile "$out/dex-worker")

# -n keeps the archive free of the file name and time, so equal input gives equal bytes.
gzip -9 -n -c "$out/dex-worker" >internal/workerbin/dex-worker.gz
