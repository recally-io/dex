<!-- dex-config:  -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd"><plist version="1.0"><dict><key>Label</key><string>io.recally.dex</string><key>ProgramArguments</key><array><string>/opt/space &amp; &#34;quote&#34; 中文 %h $HOME \path/dex</string><string>serve</string><string>--host</string><string>127.0.0.1</string><string>--port</string><string>18787</string><string>--data-dir</string><string>/data/space &amp; &#34;quote&#34; 中文 %h $HOME \path</string><string>--stored-token</string></array><key>WorkingDirectory</key><string>/home/space &amp; &#34;quote&#34; 中文 %h $HOME \path</string><key>RunAtLoad</key><true/><key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict><key>ExitTimeOut</key><integer>60</integer><key>StandardOutPath</key><string>/logs/space &amp; &#34;quote&#34; 中文 %h $HOME \path/dex.log</string><key>StandardErrorPath</key><string>/logs/space &amp; &#34;quote&#34; 中文 %h $HOME \path/dex.log</string><key>EnvironmentVariables</key><dict><key>PATH</key><string>/usr/bin:/usr/local/bin:/tools/space &amp; &#34;quote&#34; 中文 %h $HOME \path</string></dict></dict></plist>
