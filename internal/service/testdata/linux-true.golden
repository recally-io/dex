# dex-config: 
[Unit]
Description=dex bot host

[Service]
Type=simple
ExecStart=/usr/bin/env -- "/opt/space & \"quote\" 中文 %%h $$HOME \\path/dex" "serve" "--host" "127.0.0.1" "--port" "18787" "--data-dir" "/data/space & \"quote\" 中文 %%h $$HOME \\path" "--stored-token"
WorkingDirectory=%h
Environment="PATH=/usr/bin:/usr/local/bin:/tools/space & \"quote\" 中文 %%h $HOME \\path"
Restart=on-failure
TimeoutStopSec=60

[Install]
WantedBy=default.target
[Unit]
Description=dex daily update

[Service]
Type=oneshot
ExecStart=/usr/bin/env -- "/opt/space & \"quote\" 中文 %%h $$HOME \\path/dex" "update" "--scheduled"
WorkingDirectory=%h
Environment="PATH=/usr/bin:/usr/local/bin:/tools/space & \"quote\" 中文 %%h $HOME \\path"
TimeoutStartSec=10min
[Unit]
Description=dex daily update timer

[Timer]
OnCalendar=daily
Persistent=true
RandomizedDelaySec=1h

[Install]
WantedBy=timers.target
